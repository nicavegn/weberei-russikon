# =====================================================================
# Schutz für den Ordner data/
# ---------------------------------------------------------------------
# flaechen.js und flaechen.json sind öffentliche Daten und dürfen
# ausgeliefert werden. Die Sicherungen und Zwischendateien nicht.
# =====================================================================

# Der Teil (.*/)? muss optional sein: liegt die Website auf der Wurzel der
# Domain, lautet der Pfad schlicht /data/sicherungen/..., ohne Ordner davor.
# Beim Anlegen des Ordners schreibt api/lib/daten.php zusätzlich eine
# eigene .htaccess hinein.
RedirectMatch 404 ^/(.*/)?data/sicherungen/

<FilesMatch "\.tmp">
    Require all denied
</FilesMatch>

# flaechen.js ändert sich, sobald im Admin gespeichert wird. Anders als
# Gestaltung und Skripte trägt die Datei darum keine Versionsnummer im
# Verweis, sondern der Browser muss jedes Mal nachfragen, ob seine Kopie
# noch stimmt. Das kostet fast nichts: hat sich nichts geändert, antwortet
# der Server mit 304 und schickt die Datei gar nicht erst.
<IfModule mod_headers.c>
    <FilesMatch "^flaechen\.(js|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

Options -Indexes
